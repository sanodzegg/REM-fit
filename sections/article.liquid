{%- liquid
  assign brand_name = settings.textLogo | default: shop.name
  assign schema_modified = article.published_at
  if article.updated_at
    assign schema_modified = article.updated_at
  endif

  assign raw_description = article.excerpt | default: article.content
-%}
{%- capture schema_headline %}{% render 'schema-text', text: article.title %}{% endcapture -%}
{%- capture schema_description %}{% render 'schema-text', text: raw_description %}{% endcapture -%}
{%- capture schema_body %}{% render 'schema-text', text: article.content %}{% endcapture -%}
{%- assign schema_description = schema_description | strip | truncatewords: 55 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ schema_headline | strip | json }},
  "description": {{ schema_description | json }},
  {%- if article.image != blank %}
  "image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},
  {%- endif %}
  "url": {{ canonical_url | json }},
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ canonical_url | json }}
  },
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ schema_modified | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "keywords": {{ article.tags | join: ', ' | json }},
  "articleBody": {{ schema_body | strip | json }},
  "author": {
    {%- if article.author != blank %}
    "@type": "Person",
    "name": {{ article.author | json }}
    {%- else %}
    "@type": "Organization",
    "name": {{ brand_name | json }}
    {%- endif %}
  },
  "publisher": {
    "@type": "Organization",
    "@id": {{ shop.secure_url | append: '/#organization' | json }},
    "name": {{ brand_name | json }},
    "url": {{ shop.secure_url | json }}
    {%- if settings.defaultLogo != blank -%}
    ,
    "logo": {
      "@type": "ImageObject",
      "url": {{ settings.defaultLogo | image_url: width: 600 | prepend: 'https:' | json }}
    }
    {%- endif %}
  }
}
</script>

{% render 'schema-faq', content: article.content %}

<div class="row article__row">
  <div class="col-12 breadcrumbs--default">
  {% render 'breadcrumbs' %}
  </div>
  <div class="col-12 article__max-width unflex">
    <h1 class="article__title h-reset">{{ article.title }}</h1>
    {% capture date %}<time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%m/%d/%Y' }}</time>{% endcapture %}
    <div class="unflex article__meta">{{ article.author }} on {{ date }}</div>
    {% unless article.excerpt == blank %}<div class="article__excerpt">{{article.excerpt}}</div>{% endunless %}
  </div>
  {% unless article.image == nil %}
    <div class="col-12">
      <div class="unflex article__max-width--image">
        <img loading="lazy" data-src="{{article.image | img_url: '10x'}}" height="{{article.image.height}}" width="{{article.image.width}}" class="article__featured--shadow lazyload">
        {% render 'ratio-image', ratioType: 'vw', image: article.image, alt: article.image.alt, class: 'article__featured', mratio: 100, dratio: 100 %}
      </div>
    </div>
  {% endunless %}
  <div class="col-12 unflex article__content">
    <article class="article__max-width ">
      {{article.content}}
    </article>
  </div>
  <div class="col-12 article__max-width article__tags">
  {% unless article.tags.size == 0 %}
    <span>{{'general.tags.tags' | t}}: </span>
    {% for tag in article.tags %}
      <a href="{{blog.url}}/tagged/{{tag|handleize}}" class="article__tags--tag">{{tag}}</a>
    {% endfor %}
  {% endunless %}
  </div>
</div>