{% comment %}
  REM-Fit Mattress Finder
  ------------------------------------------------------------------
  This file renders a shell plus a JSON config. All quiz content, all
  branching and all matching maths come from the schema below and are
  executed by assets/mattress-finder.js — there is no quiz content in
  the JavaScript.

  Conditions (used by "show when", boosts, guides, reasons, rules):
    who=couple            answer equals
    position=back|combi   any of
    who!=couple           not equal
    partnerConflict>=1    numeric compare (>= <= > <)
    a=1,b=2               AND
    a=1;b=2               OR
    (blank)               always true
{% endcomment %}

{{ 'mattress-finder.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign is_full = false
  if s.layout_mode == 'full'
    assign is_full = true
  endif

  assign font_stack = 'var(--baseFont, "Nunito", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif)'
  if s.font_source == 'nunito'
    assign font_stack = '"Nunito", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif'
  endif

  assign purple_rgb = s.color_purple | color_to_rgb | remove: 'rgb(' | remove: ')'
  assign gold_rgb = s.color_gold_dark | color_to_rgb | remove: 'rgb(' | remove: ')'
-%}

{%- if s.hide_theme_chrome -%}
  <style>
    .container__top-part,
    .wrapper--bottom {
      display: none !important;
    }
    {% if is_full %}
      body { overflow: hidden; }
    {% endif %}
  </style>
{%- endif -%}

<style>
  #MattressFinder-{{ section.id }} {
    --rf-font: {{ font_stack }};
    --rf-purple: {{ s.color_purple }};
    --rf-purple-deep: {{ s.color_purple_deep }};
    --rf-purple-light: {{ s.color_purple_light }};
    --rf-gold: {{ s.color_gold }};
    --rf-gold-dark: {{ s.color_gold_dark }};
    --rf-bg: {{ s.color_bg }};
    --rf-tint: {{ s.color_tint }};
    --rf-border: {{ s.color_border }};
    --rf-muted: {{ s.color_muted }};
    --rf-ink: {{ s.color_ink }};
    --rf-sub-color: {{ s.color_sub }};
    --rf-error: {{ s.color_error }};
    --rf-radius: {{ s.radius }}px;
    --rf-max-width: {{ s.max_width }}px;
    --rf-min-height: {{ s.min_height }}px;
    --rf-purple-shadow: rgba({{ purple_rgb }}, 0.10);
    --rf-purple-shadow-strong: rgba({{ purple_rgb }}, 0.25);
    --rf-purple-shadow-card: rgba({{ purple_rgb }}, 0.12);
    --rf-purple-ring: rgba({{ purple_rgb }}, 0.12);
    --rf-gold-shadow: rgba({{ gold_rgb }}, 0.35);
    --rf-gold-shadow-soft: rgba({{ gold_rgb }}, 0.20);
  }
</style>

<div
  id="MattressFinder-{{ section.id }}"
  class="rf-finder {% if is_full %}rf-finder--full{% else %}rf-finder--embedded{% endif %}{% unless s.enable_animations %} rf-finder--no-anim{% endunless %}"
  data-rf-root
>
  {%- if s.show_progress -%}
    <div class="rf-progress" role="progressbar" aria-label="Quiz progress">
      <div class="rf-progress__fill" data-rf-progress-fill></div>
    </div>
  {%- endif -%}

  {%- if s.show_brand -%}
    <div class="rf-brand">{{ s.brand_text }}<span>{{ s.brand_accent }}</span></div>
  {%- endif -%}

  <div class="rf-stage" data-rf-stage aria-live="polite"></div>

  <div class="rf-nav">
    <button class="rf-nav__back" type="button" data-rf-back>{{ s.back_label }}</button>
    <div class="rf-nav__count" data-rf-counter></div>
  </div>

  <noscript>
    <div class="rf-noscript">
      <p class="rf-sub">{{ s.noscript_text }}</p>
      {%- if s.noscript_url != blank -%}
        <a class="rf-btn rf-btn--gold" href="{{ s.noscript_url }}">{{ s.noscript_link_text }}</a>
      {%- endif -%}
    </div>
  </noscript>

  {%- capture rf_config -%}
{
  "sizeAnswerKey": {{ s.size_answer_key | default: 'size' | json }},
  "sizeHelpValue": {{ s.size_help_value | default: 'help' | json }},
  "maxReasons": {{ s.max_reasons | json }},

  "layout": {
    "animate": {{ s.enable_animations | json }},
    "keyboard": {{ s.enable_keyboard | json }},
    "showCounter": {{ s.show_counter | json }},
    "counterTemplate": {{ s.counter_template | default: '' | json }},
    "progressMode": {{ s.progress_mode | default: 'auto' | json }},
    "progressExpected": {{ s.progress_expected | json }}
  },

  "weights": {
    "defaultTension": {{ s.default_tension | json }},
    "rounding": {{ s.tension_rounding | json }},
    "baseScore": {{ s.base_score | json }},
    "tensionPenalty": {{ s.tension_penalty | json }}
  },

  "result": {
    "headingTemplate": {{ s.result_heading_template | default: '' | json }},
    "showImage": {{ s.show_product_image | json }},
    "showPrice": {{ s.show_product_price | json }},
    "scaleMin": {{ s.scale_min | json }},
    "scaleMax": {{ s.scale_max | json }},
    "scaleSoftLabel": {{ s.scale_soft_label | default: '' | json }},
    "scaleFirmLabel": {{ s.scale_firm_label | default: '' | json }},
    "markerTitle": {{ s.marker_title | default: '' | json }},
    "tensionCaption": {{ s.tension_caption | default: '' | json }},
    "emptyText": {{ s.empty_text | default: '' | json }},
    "sizeTemplate": {{ s.size_template | default: '' | json }},
    "sizeSelectedNote": {{ s.size_selected_note | default: '' | json }},
    "sizeHelpedNote": {{ s.size_helped_note | default: '' | json }},
    "sizeCoupleNote": {{ s.size_couple_note | default: '' | json }},
    "sizeCoupleNoteWhen": {{ s.size_couple_note_when | default: '' | json }},
    "sizeLinkTemplate": {{ s.size_link_template | default: '' | json }},
    "sizeFootnote": {{ s.size_footnote | default: '' | json }},
    "ctaTemplate": {{ s.cta_template | default: '' | json }},
    "trustItems": [
      {%- assign tsep = '' -%}
      {%- for n in (1..4) -%}
        {%- assign tkey = 'trust_' | append: n -%}
        {%- assign tval = s[tkey] -%}
        {%- if tval != blank -%}{{ tsep }}{{ tval | json }}{%- assign tsep = ',' -%}{%- endif -%}
      {%- endfor -%}
    ],
    "guideText": {{ s.guide_text | default: '' | json }},
    "showRunner": {{ s.show_runner | json }},
    "runnerLabel": {{ s.runner_label | default: '' | json }},
    "runnerLinkText": {{ s.runner_link_text | default: '' | json }},
    "restartLabel": {{ s.restart_label | default: '' | json }}
  },

  "integrations": {
    "analytics": {{ s.analytics_enabled | json }},
    "analyticsPrefix": {{ s.analytics_prefix | default: 'rf_quiz_' | json }},
    "storageEnabled": {{ s.storage_enabled | json }},
    "storageKey": {{ s.storage_key | default: '' | json }},
    "statsEnabled": {{ s.stats_enabled | json }},
    "statsWebhookUrl": {{ s.stats_webhook_url | default: '' | json }},
    "quizVersion": {{ s.quiz_version | default: '' | json }},
    "klaviyoEnabled": {{ s.klaviyo_enabled | json }},
    "klaviyoSiteId": {{ s.klaviyo_site_id | default: '' | json }},
    "klaviyoListId": {{ s.klaviyo_list_id | default: '' | json }},
    "klaviyoSource": {{ s.klaviyo_source | default: '' | json }},
    "klaviyoEventName": {{ s.klaviyo_event_name | default: '' | json }},
    "discountEnabled": {{ s.discount_enabled | json }},
    "discountCode": {{ s.discount_code | default: '' | json }},
    "discountLabel": {{ s.discount_label | default: '' | json }},
    "discountRequiresEmail": {{ s.discount_requires_email | json }},
    "copyLabel": {{ s.copy_label | default: '' | json }},
    "copiedLabel": {{ s.copied_label | default: '' | json }}
  },

  "rules": [
    {%- assign rsep = '' -%}
    {%- for n in (1..12) -%}
      {%- assign rw = 'rule_' | append: n | append: '_when' -%}
      {%- assign ra = 'rule_' | append: n | append: '_attr' -%}
      {%- assign ram = 'rule_' | append: n | append: '_amount' -%}
      {%- if s[ra] != blank -%}
        {{ rsep }}{"when": {{ s[rw] | default: '' | json }}, "attr": {{ s[ra] | json }}, "amount": {{ s[ram] | default: 0 | json }}}
        {%- assign rsep = ',' -%}
      {%- endif -%}
    {%- endfor -%}
  ],

  "sizeRules": [
    {%- assign zsep = '' -%}
    {%- for n in (1..9) -%}
      {%- assign zw = 'size_rule_' | append: n | append: '_when' -%}
      {%- assign zv = 'size_rule_' | append: n | append: '_value' -%}
      {%- if s[zv] != blank -%}
        {{ zsep }}{"when": {{ s[zw] | default: '' | json }}, "value": {{ s[zv] | json }}}
        {%- assign zsep = ',' -%}
      {%- endif -%}
    {%- endfor -%}
  ],

  "steps": [
    {%- assign ssep = '' -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'welcome' -%}
          {{ ssep }}{
            "type": "welcome",
            "id": "welcome",
            "offerPill": {{ block.settings.offer_pill | default: '' | json }},
            "heading": {{ block.settings.heading | default: '' | json }},
            "subtext": {{ block.settings.subtext | default: '' | json }},
            "buttonText": {{ block.settings.button_text | default: '' | json }},
            "enterHint": {{ block.settings.enter_hint | default: '' | json }},
            "dataBadge": {{ block.settings.data_badge | default: '' | json }}
          }
          {%- assign ssep = ',' -%}

        {%- when 'email' -%}
          {{ ssep }}{
            "type": "email",
            "id": "email",
            "eyebrow": {{ block.settings.eyebrow | default: '' | json }},
            "heading": {{ block.settings.heading | default: '' | json }},
            "subtext": {{ block.settings.subtext | default: '' | json }},
            "placeholder": {{ block.settings.placeholder | default: '' | json }},
            "buttonText": {{ block.settings.button_text | default: '' | json }},
            "errorText": {{ block.settings.error_text | default: '' | json }},
            "fineprint": {{ block.settings.fineprint | default: '' | json }},
            "allowSkip": {{ block.settings.allow_skip | json }},
            "skipLabel": {{ block.settings.skip_label | default: '' | json }}
          }
          {%- assign ssep = ',' -%}

        {%- when 'question' -%}
          {%- assign step_id = block.settings.step_id | default: block.id -%}
          {{ ssep }}{
            "type": "question",
            "id": {{ step_id | json }},
            "saveAs": {{ block.settings.save_as | default: step_id | json }},
            "showWhen": {{ block.settings.show_when | default: '' | json }},
            "tensionOrder": {{ block.settings.tension_order | default: 0 | json }},
            "conflictWith": {{ block.settings.conflict_with | default: '' | json }},
            "eyebrow": {{ block.settings.eyebrow | default: '' | json }},
            "title": {{ block.settings.title | default: '' | json }},
            "subtext": {{ block.settings.subtext | default: '' | json }},
            "proofPct": {{ block.settings.proof_pct | default: '' | json }},
            "proofText": {{ block.settings.proof_text | default: '' | json }},
            "proofSub": {{ block.settings.proof_sub | default: '' | json }},
            "proofWhen": {{ block.settings.proof_when | default: '' | json }},
            "options": [
              {%- assign osep = '' -%}
              {%- for i in (1..6) -%}
                {%- assign k_value = 'opt_' | append: i | append: '_value' -%}
                {%- if block.settings[k_value] != blank -%}
                  {%- assign k_label = 'opt_' | append: i | append: '_label' -%}
                  {%- assign k_hint = 'opt_' | append: i | append: '_hint' -%}
                  {%- assign k_emoji = 'opt_' | append: i | append: '_emoji' -%}
                  {%- assign k_token = 'opt_' | append: i | append: '_token' -%}
                  {%- assign k_link = 'opt_' | append: i | append: '_link' -%}
                  {%- assign k_ext = 'opt_' | append: i | append: '_extended' -%}
                  {%- assign k_next = 'opt_' | append: i | append: '_next' -%}
                  {%- assign k_op = 'opt_' | append: i | append: '_tension_op' -%}
                  {%- assign k_tv = 'opt_' | append: i | append: '_tension_value' -%}
                  {%- assign k_tw = 'opt_' | append: i | append: '_tension_weight' -%}
                  {{ osep }}{
                    "value": {{ block.settings[k_value] | json }},
                    "label": {{ block.settings[k_label] | default: '' | json }},
                    "hint": {{ block.settings[k_hint] | default: '' | json }},
                    "emoji": {{ block.settings[k_emoji] | default: '' | json }},
                    "token": {{ block.settings[k_token] | default: '' | json }},
                    "link": {{ block.settings[k_link] | default: '' | json }},
                    "extended": {{ block.settings[k_ext] | json }},
                    "next": {{ block.settings[k_next] | default: '' | json }},
                    "tensionOp": {{ block.settings[k_op] | default: 'none' | json }},
                    "tensionValue": {{ block.settings[k_tv] | default: 0 | json }},
                    "tensionWeight": {{ block.settings[k_tw] | default: 0.4 | json }}
                  }
                  {%- assign osep = ',' -%}
                {%- endif -%}
              {%- endfor -%}
            ]
          }
          {%- assign ssep = ',' -%}

      {%- endcase -%}
    {%- endfor -%}
  ],

  "products": [
    {%- assign psep = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'product' -%}
        {%- assign prod = block.settings.product -%}
        {%- assign p_url = block.settings.custom_url | default: prod.url -%}
        {%- assign p_key = block.settings.key | default: prod.handle | default: block.id -%}
        {%- assign p_name = block.settings.name_override | default: prod.title -%}
        {%- assign p_img = block.settings.image | default: prod.featured_image -%}
        {{ psep }}{
          "key": {{ p_key | json }},
          "name": {{ p_name | default: '' | json }},
          "short": {{ block.settings.short | default: p_name | default: '' | json }},
          "tag": {{ block.settings.tag | default: '' | json }},
          "blurb": {{ block.settings.blurb | default: '' | json }},
          "runnerLine": {{ block.settings.runner_line | default: '' | json }},
          "url": {{ p_url | default: '' | json }},
          "image": {%- if p_img %}{{ p_img | image_url: width: 800 | json }}{% else %}""{% endif -%},
          "price": {%- if prod != blank %}{{ prod.price | money | json }}{% else %}""{% endif -%},
          "compareAtPrice": {%- if prod != blank and prod.compare_at_price > prod.price %}{{ prod.compare_at_price | money | json }}{% else %}""{% endif -%},
          "tension": {{ block.settings.tension | json }},
          "tensionLabel": {{ block.settings.tension_label | default: '' | json }},
          "cooling": {{ block.settings.cooling | json }},
          "natural": {{ block.settings.natural | json }},
          "foam": {{ block.settings.foam | json }},
          "priceBand": {{ block.settings.price_band | default: '1' | json }},
          "excludeUnless": {{ block.settings.exclude_unless | default: '' | json }},
          "features": [
            {%- assign fsep = '' -%}
            {%- for n in (1..3) -%}
              {%- assign fkey = 'feature_' | append: n -%}
              {%- if block.settings[fkey] != blank -%}{{ fsep }}{{ block.settings[fkey] | json }}{%- assign fsep = ',' -%}{%- endif -%}
            {%- endfor -%}
          ],
          "boosts": [
            {%- assign bsep = '' -%}
            {%- for n in (1..3) -%}
              {%- assign bw = 'boost_' | append: n | append: '_when' -%}
              {%- assign ba = 'boost_' | append: n | append: '_amount' -%}
              {%- if block.settings[bw] != blank -%}
                {{ bsep }}{"when": {{ block.settings[bw] | json }}, "amount": {{ block.settings[ba] | default: 0 | json }}}
                {%- assign bsep = ',' -%}
              {%- endif -%}
            {%- endfor -%}
          ]
        }
        {%- assign psep = ',' -%}
      {%- endif -%}
    {%- endfor -%}
  ],

  "guides": [
    {%- assign gsep = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'guide' -%}
        {{ gsep }}{
          "when": {{ block.settings.when | default: '' | json }},
          "title": {{ block.settings.title | default: '' | json }},
          "url": {{ block.settings.url | default: '' | json }}
        }
        {%- assign gsep = ',' -%}
      {%- endif -%}
    {%- endfor -%}
  ],

  "reasons": [
    {%- assign nsep = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'reason' -%}
        {{ nsep }}{
          "when": {{ block.settings.when | default: '' | json }},
          "text": {{ block.settings.text | default: '' | json }}
        }
        {%- assign nsep = ',' -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
  {%- endcapture -%}
  <script type="application/json" data-rf-config>{{ rf_config }}</script>
</div>

<script src="{{ 'mattress-finder.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Mattress finder",
  "tag": "section",
  "class": "mattress-finder-section",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout mode",
      "default": "full",
      "options": [
        {
          "value": "full",
          "label": "Full viewport takeover"
        },
        {
          "value": "embedded",
          "label": "Embedded in page"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "hide_theme_chrome",
      "label": "Hide theme header & footer",
      "default": true,
      "info": "Hides the theme header, info bars and footer on this page only."
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (embedded)",
      "default": 720,
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content width",
      "default": 660,
      "min": 440,
      "max": 1000,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_brand",
      "label": "Show brand mark",
      "default": true
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "default": "REM-"
    },
    {
      "type": "text",
      "id": "brand_accent",
      "label": "Brand accent text",
      "default": "Fit"
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Show progress bar",
      "default": true
    },
    {
      "type": "select",
      "id": "progress_mode",
      "label": "Progress calculation",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automatic (count visible questions)"
        },
        {
          "value": "fixed",
          "label": "Fixed expected length"
        }
      ]
    },
    {
      "type": "range",
      "id": "progress_expected",
      "label": "Expected questions",
      "default": 8,
      "min": 1,
      "max": 20,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "label": "Show question counter",
      "default": true
    },
    {
      "type": "text",
      "id": "counter_template",
      "label": "Counter text",
      "default": "Question {{n}}",
      "info": "Tokens: {{n}}, {{total}}"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back button label",
      "default": "← Back"
    },
    {
      "type": "checkbox",
      "id": "enable_keyboard",
      "label": "Enable keyboard shortcuts",
      "default": true,
      "info": "A–F selects an option, Enter advances the welcome and email screens."
    },
    {
      "type": "checkbox",
      "id": "enable_animations",
      "label": "Enable screen transitions",
      "default": true
    },
    {
      "type": "text",
      "id": "noscript_text",
      "label": "No-JavaScript message",
      "default": "This quiz needs JavaScript. Browse our mattresses instead."
    },
    {
      "type": "url",
      "id": "noscript_url",
      "label": "No-JavaScript link"
    },
    {
      "type": "text",
      "id": "noscript_link_text",
      "label": "No-JavaScript link text",
      "default": "Browse our mattresses"
    },
    {
      "type": "header",
      "content": "Colours & type"
    },
    {
      "type": "color",
      "id": "color_purple",
      "label": "Purple",
      "default": "#3F2155"
    },
    {
      "type": "color",
      "id": "color_purple_deep",
      "label": "Purple (deep)",
      "default": "#2E1740"
    },
    {
      "type": "color",
      "id": "color_purple_light",
      "label": "Purple (light)",
      "default": "#B79ED1"
    },
    {
      "type": "color",
      "id": "color_gold",
      "label": "Gold",
      "default": "#F7C948"
    },
    {
      "type": "color",
      "id": "color_gold_dark",
      "label": "Gold (dark)",
      "default": "#DBA914"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Background",
      "default": "#F8F5FB"
    },
    {
      "type": "color",
      "id": "color_tint",
      "label": "Tint",
      "default": "#F0EBF5"
    },
    {
      "type": "color",
      "id": "color_border",
      "label": "Border",
      "default": "#E0D8EA"
    },
    {
      "type": "color",
      "id": "color_muted",
      "label": "Muted text",
      "default": "#7F68A0"
    },
    {
      "type": "color",
      "id": "color_ink",
      "label": "Body text",
      "default": "#2B2138"
    },
    {
      "type": "color",
      "id": "color_sub",
      "label": "Subheading text",
      "default": "#5C3D78"
    },
    {
      "type": "color",
      "id": "color_error",
      "label": "Error text",
      "default": "#B03A2E"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "default": 14,
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "font_source",
      "label": "Font",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme font"
        },
        {
          "value": "nunito",
          "label": "Nunito"
        }
      ]
    },
    {
      "type": "header",
      "content": "Result card"
    },
    {
      "type": "text",
