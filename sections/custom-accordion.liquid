{%- if section.settings.heading != blank -%}
  <h2>{{ section.settings.heading | escape }}</h2>
{%- endif -%}

<div class="acc"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | escape }}"{% endif %}>
  {%- for block in section.blocks -%}
    {%- case block.type -%}

      {%- when 'panel' -%}
        <details {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.summary | escape }}</summary>
          <div class="acc__body">
            {%- if block.settings.callout != blank -%}
              <p class="callout">{{ block.settings.callout | escape }}</p>
            {%- endif -%}
            {{ block.settings.content }}
          </div>
        </details>

    {%- endcase -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Custom accordion",
  "tag": "section",
  "class": "custom-accordion",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "admin",
      "info": "Used as the section's id, so links elsewhere on the page can jump to it."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Leave blank for a bare run of panels with no title above them."
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        {
          "type": "text",
          "id": "summary",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "callout",
          "label": "Callout",
          "info": "Optional. Renders as the highlighted first line of the panel."
        },
        {
          "type": "html",
          "id": "content",
          "label": "Content",
          "info": "Raw HTML, so tables and multiple paragraphs are all fine. Wrap body copy in <p> tags — bare text will not pick up the panel's typography."
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
