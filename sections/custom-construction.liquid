{%- liquid
  assign layup = section.settings.layup_image
  assign layup_alt = section.settings.layup_alt | default: layup.alt
-%}

<div class="sec" id="{{ section.settings.anchor | default: 'construction' | escape }}">
  {%- if section.settings.heading != blank -%}
    <h2>{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if layup != blank -%}
    {{
      layup
      | image_url: width: 1600
      | image_tag:
        class: 'layup',
        alt: layup_alt,
        loading: 'lazy',
        widths: '400, 600, 800, 1000, 1200, 1600'
    }}
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- case block.type -%}

      {%- when 'layer' -%}
        {%- liquid
          assign layer_title = block.settings.heading
          if block.settings.number != blank
            assign layer_title = block.settings.number | append: ' · ' | append: block.settings.heading
          endif
        -%}
        <h3 {{ block.shopify_attributes }}>{{ layer_title | escape }}</h3>
        {{ block.settings.text }}

      {%- when 'video' -%}
        {%- liquid
          assign video = block.settings.video
          assign poster = block.settings.poster | default: video.preview_image

          # Sorted rather than taken as given, so the highest-quality mp4 is always the
          # first <source>. Browsers pick the first they can play; Shopify's own ordering
          # is not guaranteed.
          assign mp4 = video.sources | where: 'format', 'mp4' | sort: 'height' | reverse
        -%}
        {%- if video != blank -%}
          <figure class="vid" {{ block.shopify_attributes }}>
            <video
              preload="{% if block.settings.autoplay %}auto{% else %}none{% endif %}"
              playsinline
              {% if block.settings.controls %}controls{% endif %}
              {% if block.settings.autoplay %}autoplay muted{% endif %}
              {% if block.settings.loop %}loop{% endif %}
              {% if poster != blank %}poster="{{ poster | image_url: width: 900 }}"{% endif %}
            >
              {%- for source in mp4 -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>

            {%- if block.settings.caption_lead != blank or block.settings.caption_text != blank -%}
              <figcaption>
                {%- if block.settings.caption_lead != blank -%}
                  <b>{{ block.settings.caption_lead | escape }}</b>
                {%- endif -%}
                {{ block.settings.caption_text | strip_html }}
              </figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}

    {%- endcase -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Custom construction",
  "tag": "section",
  "class": "custom-construction",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "construction",
      "info": "Used as the section's id, so links elsewhere on the page can jump to it."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Inside the mattress"
    },
    {
      "type": "header",
      "content": "Cutaway image"
    },
    {
      "type": "image_picker",
      "id": "layup_image",
      "label": "Layup image"
    },
    {
      "type": "text",
      "id": "layup_alt",
      "label": "Alt text",
      "info": "Describes the image for screen readers and when the image fails to load. Leave blank to use the alt text set in the media library."
    }
  ],
  "blocks": [
    {
      "type": "layer",
      "name": "Layer",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Layer number",
          "info": "Set by hand rather than counted automatically, since videos sit between layers."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Layer name"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description"
        }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster image",
          "info": "Optional. Falls back to the video's own preview image."
        },
        {
          "type": "text",
          "id": "caption_lead",
          "label": "Caption lead",
          "info": "The bold sentence at the start of the caption."
        },
        {
          "type": "richtext",
          "id": "caption_text",
          "label": "Caption"
        },
        {
          "type": "header",
          "content": "Playback"
        },
        {
          "type": "checkbox",
          "id": "controls",
          "label": "Show controls",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "autoplay",
          "label": "Autoplay",
          "default": false,
          "info": "Autoplaying video must be muted to start in most browsers."
        },
        {
          "type": "checkbox",
          "id": "loop",
          "label": "Loop",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
