        "panel_construction": {
          "type": "panel",
          "settings": {
            "summary": "Construction and materials",
            "callout": "",
            "content": "<p>Depth 25cm. Top comfort layer: premium viscoelastic open-cell memory foam, 5cm, zoned. Second comfort layer: PU foam, 2.5cm. Dual spring system: 2000 encapsulated pocket springs at 12.5cm plus 2000 mini pocket springs at 2.5cm, firm tension gauge. Side walls and base layer: high-density foam.</p>\n<p>Cover: Re-Ax thermo-regulating hypoallergenic knit, removable and washable.</p>",
            "open": false
          }
