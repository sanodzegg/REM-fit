    "why": {
      "type": "custom-why",
      "blocks": {
        "passage_fyne7n": {
          "type": "passage",
          "settings": {
            "heading": "What makes it different",
            "text": "<p>Most hybrid mattresses use a single layer of pocket springs. The 4000 Ortho Elite uses a dual-layer system, doubling the spring count and significantly increasing the stability and longevity of the support core. The stability-focused memory foam above the springs minimises sink, keeping your hips and shoulders from dropping out of alignment as you sleep.</p>"
          }
        }
      },
      "block_order": [
        "passage_fyne7n"
      ],
      "settings": {
        "anchor": "why",
        "heading": "Who the 4000 Ortho Elite is for",
        "intro": "<p>The best choice if you suffer from back pain, prefer to sleep on your back or stomach, or need a firmer mattress that holds its shape under pressure. At firm tension 9/10 it delivers corrective orthopaedic support and is rated for sleepers up to 20 stone. It is also the right upgrade if your current mattress has started to sag.</p>"
      }
    },
    "construction": {
      "type": "custom-construction",
      "blocks": {
        "layer_FRgwPF": {
          "type": "layer",
          "settings": {
            "number": "1",
            "heading": "Breathable cover",
            "text": "<p>Re-Ax thermo-regulating hypoallergenic cover. Removable and machine washable.</p>"
          }
        },
        "video_Vrz3qd": {
          "type": "video",
          "settings": {
            "video": "shopify://files/videos/A_block_of_open_cell_memory_fo.mp4",
            "poster": "shopify://shop_images/4000OrthoEliteCentipur.jpg",
            "caption_lead": "Airflow through the cover and foam.",
            "caption_text": "<p> A firm mattress puts more of your body on the surface rather than in it, so the cover and the open-cell structure beneath do most of the temperature work.</p>",
            "controls": false,
            "autoplay": true,
            "loop": true
          }
        },
        "layer_QhReM8": {
          "type": "layer",
          "settings": {
            "number": "2",
            "heading": "Cool, adaptive memory foam",
            "text": "<p>Open-cell memory foam, 5cm, zoned for tailored support. The open-cell structure encourages airflow rather than trapping heat, so it runs cooler than traditional memory foam.</p>"
          }
        },
        "video_KPDcV3": {
          "type": "video",
          "settings": {
            "video": "shopify://files/videos/Ultra_clean_ecommerce_product.mp4",
            "poster": "shopify://shop_images/500-comfortdetailsV2_c77850a5-5ba5-4b24-8146-13956d445b6c.jpg",
            "caption_lead": "Contouring without sink.",
            "caption_text": "<p> The foam gives at the shoulder and hip, but the stability layer beneath stops it travelling far — the difference between pressure relief and losing your alignment.</p>",
            "controls": false,
            "autoplay": true,
            "loop": true
          }
        },
        "layer_4McjD3": {
          "type": "layer",
          "settings": {
            "number": "3",
            "heading": "Performance foam",
            "text": "<p>PU foam, 2.5cm. Reinforces the structure and prevents settlement of the sleeping surface.</p>"
          }
        },
        "layer_fFgbgJ": {
          "type": "layer",
          "settings": {
            "number": "4",
            "heading": "Zoned support",
            "text": "<p>Cushions shoulders and supports hips for proper spinal alignment.</p>"
          }
        },
        "layer_GdQhpr": {
          "type": "layer",
          "settings": {
            "number": "5",
            "heading": "Dual-layer pocket springs",
            "text": "<p>2000 encapsulated pocket springs at 12.5cm plus 2000 mini pocket springs at 2.5cm — 4000 in total, firm tension gauge, with zero motion transfer.</p>"
          }
        },
        "video_4gQJkH": {
          "type": "video",
          "settings": {
            "video": "shopify://files/videos/Luxury_mattress_cutaway_animat (1).mp4",
            "poster": "shopify://shop_images/4000OrthoElitePocketSprings.jpg",
            "caption_lead": "Springs compressing independently.",
            "caption_text": "<p> On the firm gauge each spring travels less than it would in a medium mattress — that shorter travel is what holds the spine level, and why movement on one side doesn't carry across.</p>",
            "controls": false,
            "autoplay": true,
            "loop": true
          }
        },
        "layer_tHkkCL": {
          "type": "layer",
          "settings": {
            "number": "6",
            "heading": "Side support walls",
            "text": "<p>High-density foam prevents roll-off and improves longevity.</p>"
          }
        },
        "layer_fK6YP3": {
          "type": "layer",
          "settings": {
            "number": "7",
            "heading": "Base layer",
            "text": "<p>High-density foam, suitable for all base types. Slatted bases need slats no more than 10cm apart.</p>"
          }
        }
      },
