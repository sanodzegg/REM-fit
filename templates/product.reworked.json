            "callout": "",
            "content": "<table>\n<thead><tr>\n<th>Size</th>\n<th>Dimensions</th>\n<th>Weight</th>\n</tr></thead>\n<tbody>\n<tr>\n<td>Small Single</td>\n<td>75 × 190 cm</td>\n<td>23 kg</td>\n</tr>\n<tr>\n<td>Long Small Single</td>\n<td>75 × 200 cm</td>\n<td>26 kg</td>\n</tr>\n<tr>\n<td>UK Single</td>\n<td>90 × 190 cm</td>\n<td>26 kg</td>\n</tr>\n<tr>\n<td>EU Single</td>\n<td>90 × 200 cm</td>\n<td>27.5 kg</td>\n</tr>\n<tr>\n<td>Small Double</td>\n<td>120 × 190 cm</td>\n<td>33 kg</td>\n</tr>\n<tr>\n<td>UK Double</td>\n<td>135 × 190 cm</td>\n<td>38 kg</td>\n</tr>\n<tr>\n<td>EU Double</td>\n<td>140 × 200 cm</td>\n<td>38.5 kg</td>\n</tr>\n<tr>\n<td>UK King</td>\n<td>150 × 200 cm</td>\n<td>44 kg</td>\n</tr>\n<tr>\n<td>EU King</td>\n<td>160 × 200 cm</td>\n<td>44.5 kg</td>\n</tr>\n<tr>\n<td>Super King</td>\n<td>180 × 200 cm</td>\n<td>52 kg</td>\n</tr>\n</tbody>\n</table>\n<p style=\"margin-top:9px;\">Every size is 25cm deep with identical construction.</p>",
