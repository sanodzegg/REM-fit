{% comment %}
  Structured data for /pages/* templates.

  Accepts:
    page  {page}    the page object
    type  {string}  'Article' or 'WebPage'. Defaults to 'WebPage'.

  Optional page metafields, used when present:
    custom.schema_image   {file_reference}  lead image for the page
    custom.date_modified  {date}            genuine last-edit date
{% endcomment %}

{%- liquid
  assign brand_name = settings.textLogo | default: shop.name
  assign schema_type = type | default: ''
  if schema_type == blank
    assign schema_type = 'WebPage'
    assign editorial_handles = 'sleep-health-hub,orthopaedic-mattress,uk-sleep-statistics,uk-sleeper-preferences,back-pain-mattress-data' | split: ','
    assign editorial_patterns = '-vs-,compar,best-mattress-for,best-pillow-for,sciatica,fibromyalgia,menopause,arthritis,spondylitis' | split: ','

    for editorial_handle in editorial_handles
      if page.handle == editorial_handle
        assign schema_type = 'Article'
        break
      endif
    endfor

    if schema_type == 'WebPage'
      for editorial_pattern in editorial_patterns
        if page.handle contains editorial_pattern
          assign schema_type = 'Article'
          break
        endif
      endfor
    endif
  endif

  assign raw_description = page_description | default: page.content

  assign schema_image_url = ''
  assign schema_image = page.metafields.custom.schema_image.value
  if schema_image
    assign schema_image_url = schema_image | image_url: width: 1200 | prepend: 'https:'
  elsif settings.defaultLogo != blank
    assign schema_image_url = settings.defaultLogo | image_url: width: 600 | prepend: 'https:'
  endif

  assign schema_modified = page.metafields.custom.date_modified.value | default: page.published_at
-%}
{%- capture schema_description %}{% render 'schema-text', text: raw_description %}{% endcapture -%}
{%- assign schema_description = schema_description | strip | truncatewords: 55 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": {{ schema_type | json }},
  {%- if schema_type == 'Article' %}
  "headline": {{ page.title | json }},
  {%- else %}
  "name": {{ page.title | json }},
  {%- endif %}
  "description": {{ schema_description | json }},
  {%- if schema_image_url != blank %}
  "image": {{ schema_image_url | json }},
  {%- endif %}
  "url": {{ canonical_url | json }},
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ canonical_url | json }}
  },
  "datePublished": {{ page.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ schema_modified | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "inLanguage": {{ request.locale.iso_code | json }},
  "isPartOf": {
    "@type": "WebSite",
    "name": {{ brand_name | json }},
    "url": {{ shop.secure_url | json }}
  },
  "author": {
    "@type": "Organization",
    "name": {{ brand_name | json }},
    "url": {{ shop.secure_url | json }}
  },
  "publisher": {
    "@type": "Organization",
    "@id": {{ shop.secure_url | append: '/#organization' | json }},
    "name": {{ brand_name | json }},
    "url": {{ shop.secure_url | json }}
    {%- if settings.defaultLogo != blank -%}
    ,
    "logo": {
      "@type": "ImageObject",
      "url": {{ settings.defaultLogo | image_url: width: 600 | prepend: 'https:' | json }}
    }
    {%- endif %}
  }
}
</script>
