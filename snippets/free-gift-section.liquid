{% comment %} tags - free-gift-double, free-gift-single {% endcomment %}

{%- unless product.tags contains 'clearance' -%}
{%- if settings.enable_freegift_widget and product.id != 15990166520188 -%}

{%- liquid
  assign gift_refs = product.metafields.custom.free_gift_products.value

  assign qty_meta = product.metafields.custom.free_gift_quantities
  assign qty_list = ''
  if qty_meta
    assign qty_list = qty_meta.value | join: ',' | append: '' | split: ','
  endif

  assign sel_variant = product.selected_or_first_available_variant
  assign sel_key = ''
  if sel_variant
    assign words = sel_variant.title | split: ' '
    for w in words
      assign lw = w | downcase
      if lw contains 'x'
        break
      endif
      unless lw == 'size'
        assign sel_key = sel_key | append: lw | append: ' '
      endunless
    endfor
    assign sel_key = sel_key | strip
  endif

  assign size_is_large = false
  if sel_key contains 'double' or sel_key contains 'king'
    assign size_is_large = true
  endif

  assign sel_tier = 'single'
  if size_is_large
    assign sel_tier = 'double'
  endif
-%}

{%- if gift_refs.size > 0 -%}
  {%- liquid
    assign rows = ''
    assign data = ''
    assign total = 0
    assign shown = 0
  -%}

  {%- for gift in gift_refs -%}
    {%- liquid
      assign i = forloop.index0

      assign tier = 'any'
      if gift.tags contains 'free-gift-double'
        assign tier = 'double'
      elsif gift.tags contains 'free-gift-single'
        assign tier = 'single'
      endif

      assign base_qty = 1
      if qty_list[i] != blank
        assign base_qty = qty_list[i] | strip | plus: 0
      endif
      if base_qty < 1
        assign base_qty = 1
      endif

      assign doubles = false
      if gift.tags contains 'free-gift-pillow'
        assign doubles = true
      endif

      assign qty = base_qty
      if doubles and size_is_large
        assign qty = base_qty | times: 2
      endif

      assign sized = false
      for opt in gift.options_with_values
        assign on = opt.name | downcase
        if on contains 'size' and gift.variants.size > 1
          assign sized = true
        endif
      endfor

      assign gv = gift.selected_or_first_available_variant
    -%}

    {%- if sized -%}
      {%- for v in gift.variants -%}
        {%- liquid
          assign vkey = ''
          assign vwords = v.title | split: ' '
          for w in vwords
            assign lw = w | downcase
            if lw contains 'x'
              break
            endif
            unless lw == 'size'
              assign vkey = vkey | append: lw | append: ' '
            endunless
          endfor
          assign vkey = vkey | strip
        -%}
        {%- if vkey == sel_key and sel_key != blank -%}
          {%- assign gv = v -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- liquid
      assign unit = gv.compare_at_price | default: 0
      if unit < gv.price
        assign unit = gv.price
      endif

      assign visible = false
      if tier == 'any' or tier == sel_tier
        assign visible = true
      endif

      assign line = unit | times: qty
      if visible
        assign total = total | plus: line
        assign shown = shown | plus: 1
      endif
    -%}

    {%- capture rows -%}
      {{ rows }}
      <div class="rfg__row" data-rfg-row="{{ i }}" data-rfg-tier="{{ tier }}"{% unless visible %} style="display:none"{% endunless %}>
        <span class="rfg__tick" aria-hidden="true"></span>
        {%- if gift.featured_image -%}
          <img class="rfg__img" src="{{ gift.featured_image | image_url: width: 96 }}" alt="" width="44" height="44" loading="lazy">
        {%- else -%}
          <span class="rfg__img" aria-hidden="true"></span>
        {%- endif -%}
        <div class="rfg__main">
          <div class="rfg__top">
            <p class="rfg__name">
              <span class="rfg__qty" data-rfg-qty>{%- if qty > 1 -%}{{ qty }}&nbsp;×&nbsp;{%- endif -%}</span>{{ gift.title | strip }}
            </p>
            <span class="rfg__val" data-rfg-val>{{ line | money }}</span>
          </div>
          {%- if sized -%}
            <div class="rfg__size">You choose your size when you add to basket</div>
          {%- endif -%}
        </div>
      </div>
    {%- endcapture -%}

    {%- capture data -%}
      {{ data }}{% unless forloop.first %},{% endunless %}{
        "qty": {{ base_qty }},
        "doubles": {{ doubles }},
        "tier": {{ tier | json }},
        "sized": {{ sized }},
        "price": {{ unit }},
        "sizes": { {%- if sized -%}
          {%- for v in gift.variants -%}
            {%- liquid
              assign vkey = ''
              assign vwords = v.title | split: ' '
              for w in vwords
                assign lw = w | downcase
                if lw contains 'x'
                  break
                endif
                unless lw == 'size'
                  assign vkey = vkey | append: lw | append: ' '
                endunless
              endfor
              assign vkey = vkey | strip
              assign vunit = v.compare_at_price | default: 0
              if vunit < v.price
                assign vunit = v.price
              endif
            -%}
            {%- unless forloop.first -%},{%- endunless -%}
            {{ vkey | json }}: { "id": {{ v.id }}, "price": {{ vunit }} }
          {%- endfor -%}
        {%- endif -%} }
      }
    {%- endcapture -%}
  {%- endfor -%}

  <div class="rfg" id="rfg-{{ product.id }}" data-rfg>
    <div class="rfg__head">
      <div class="rfg__eyebrow">
        <svg class="rfg__mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <rect x="1.4" y="6.6" width="13.2" height="8" rx="1"/>
          <path d="M0.9 4.2h14.2v2.4H0.9z"/>
          <path d="M8 4.2v10.4"/>
          <path d="M8 4.2S6.9 1.4 5.2 1.4a1.5 1.5 0 000 2.8z"/>
          <path d="M8 4.2s1.1-2.8 2.8-2.8a1.5 1.5 0 010 2.8z"/>
        </svg>
        <span class="rfg__kicker">Included free with your order</span>
      </div>
      <h2 class="rfg__title" data-rfg-title>Free gifts, worth {{ total | money }}</h2>
    </div>

    <div class="rfg__items" data-rfg-items>
      {{ rows }}
    </div>

    <div class="rfg__total" data-rfg-total>
      <span class="rfg__total-l">Total value, free to you</span>
      <span class="rfg__total-r" data-rfg-total-val>{{ total | money }}</span>
    </div>

    <p class="rfg__sr" role="status" aria-live="polite" data-rfg-live></p>
  </div>

  <script type="application/json" data-rfg-data="{{ product.id }}">
    {"gifts":[{{ data }}],"moneyFormat":{{ shop.money_format | json }},"discountRate":{{ settings.percentage_discount | default: 0 | times: 0.01 }},"discountWidget":{% if settings.enable_discount_widget %}true{% else %}false{% endif %}}
  </script>

  <script>
    (function () {
      var root = document.getElementById('rfg-{{ product.id }}');
      if (!root || root.dataset.rfgBound) return;
      root.dataset.rfgBound = '1';

      var cfg = JSON.parse(document.querySelector('[data-rfg-data="{{ product.id }}"]').textContent);
      var gifts = cfg.gifts;
      var rows = root.querySelectorAll('[data-rfg-row]');
      var live = root.querySelector('[data-rfg-live]');
      var titleEl = root.querySelector('[data-rfg-title]');
      var totalEl = root.querySelector('[data-rfg-total]');
      var totalVal = root.querySelector('[data-rfg-total-val]');

      var VARIANTS = {
        {%- for v in product.variants -%}
          {%- liquid
            assign vkey = ''
            assign vlabel = ''
            assign vwords = v.title | split: ' '
            for w in vwords
              assign lw = w | downcase
              if lw contains 'x'
                break
              endif
              assign vlabel = vlabel | append: w | append: ' '
              unless lw == 'size'
                assign vkey = vkey | append: lw | append: ' '
              endunless
            endfor
            assign vkey = vkey | strip
            assign vlabel = vlabel | strip
          -%}
          {%- unless forloop.first -%},{%- endunless -%}
          "{{ v.id }}": { "key": {{ vkey | json }}, "label": {{ vlabel | json }} }
        {%- endfor -%}
      };

      {%- comment -%}
        The amount placeholder must reach the browser as literal text, so it is wrapped
        in raw. Emitting it through an output tag is a Liquid syntax error: the tag
        closes at the first pair of braces and the rest of the string is left dangling.
      {%- endcomment -%}
      var DEFAULT_MONEY_FORMAT = '{% raw %}£{{amount}}{% endraw %}';

      function money(cents) {
        var f = cfg.moneyFormat || DEFAULT_MONEY_FORMAT;
        function build(decimals, thousands, decimal) {
          var n = (cents / 100).toFixed(decimals);
          var parts = n.split('.');
          parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, thousands);
          return parts.length > 1 ? parts[0] + decimal + parts[1] : parts[0];
        }
        return f
          .replace(/\{\{\s*amount\s*\}\}/g, build(2, ',', '.'))
          .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, build(2, '.', ','))
          .replace(/\{\{\s*amount_no_decimals_with_comma_separator\s*\}\}/g, build(0, '.', ','))
          .replace(/\{\{\s*amount_no_decimals\s*\}\}/g, build(0, ',', '.'))
          .replace(/<[^>]*>/g, '');
      }

      function num(text) {
        return parseFloat(String(text).replace(/[^\d.-]+/g, '')) || 0;
      }

      var subtotal = {{ total }};
      var visibleCount = {{ shown }};

      var serverTier = {{ sel_tier | json }};

      function renderRows(size) {
        var key = size ? size.key : '';
        var tier = key ? (/double|king/.test(key) ? 'double' : 'single') : serverTier;
        var large = tier === 'double';
        subtotal = 0;
        visibleCount = 0;

        gifts.forEach(function (g, i) {
          var row = rows[i];
          if (!row) return;

          var show = g.tier === 'any' || g.tier === tier;
          row.style.display = show ? '' : 'none';
          if (!show) return;

          var qty = g.doubles && large ? g.qty * 2 : g.qty;
          var unit = g.sized && key && g.sizes[key] ? g.sizes[key].price : g.price;
          var lineTotal = unit * qty;
          subtotal += lineTotal;
          visibleCount += 1;

          row.querySelector('[data-rfg-qty]').textContent = qty > 1 ? qty + ' × ' : '';
          row.querySelector('[data-rfg-val]').textContent = money(lineTotal);
        });
      }

      function updateTotals() {
        titleEl.textContent =
          (visibleCount === 1 ? 'Free gift, worth ' : 'Free gifts, worth ') + money(subtotal);
        totalVal.textContent = money(subtotal);
        totalEl.style.display = visibleCount === 1 ? 'none' : '';

        var productPrice = num((document.getElementById('prod-price') || {}).textContent);
        var compProdPrice = num((document.getElementById('comp-prod-price') || {}).textContent);
        var totalPounds = subtotal / 100;
        var savings;
        if (cfg.discountWidget) {
          savings = totalPounds + (compProdPrice - productPrice * (1 - cfg.discountRate));
        } else {
          savings = totalPounds + compProdPrice - productPrice;
        }
        document.querySelectorAll('.total_discounted_amount').forEach(function (el) {
          el.textContent = Math.ceil(savings);
        });
      }

      var lastKey = null;
      function sync(announce) {
        var input = document.querySelector('input[data-bstr-variant-input="{{ product.id }}"]');
        var id = input && input.getAttribute('value');
        var size = id && VARIANTS[id] ? VARIANTS[id] : null;
        var key = size ? size.key : '';
        if (key && key !== lastKey) {
          lastKey = key;
          renderRows(size);
          if (announce && live) {
            live.textContent = 'Mattress size ' + size.label + '. Free gifts updated.';
          }
        }
        updateTotals();
      }

      var variantInput = document.querySelector('input[data-bstr-variant-input="{{ product.id }}"]');
      if (variantInput) {
        new MutationObserver(function () { sync(true); })
          .observe(variantInput, { attributes: true, attributeFilter: ['value'] });
      }
      document.addEventListener('change', function (e) {
        if (e.target && e.target.id === 'size_dropdown') {
          setTimeout(function () { sync(true); }, 0);
        }
      });

      setTimeout(updateTotals, 1500);

      sync(false);

    })();
  </script>
{%- endif -%}

{%- comment -%} Rebuy 196540 — "Pillow protector on mattress pages in free gift section (ATC btn)". {%- endcomment -%}
<div data-rebuy-id="196540" data-rebuy-shopify-product-ids="{{ product.id }}"></div>

{%- endif -%}
{%- endunless -%}
