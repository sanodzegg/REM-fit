{% comment %}Plain text for JSON-LD: strips tags, then decodes the entities strip_html leaves behind so the markup matches the text the page displays. Usage: {%- capture x %}{% render 'schema-text', text: value %}{% endcapture -%}{% endcomment %}
{{- text | strip_html | replace: '&nbsp;', ' ' | replace: '&mdash;', '—' | replace: '&ndash;', '–' | replace: '&hellip;', '…' | replace: '&rsquo;', '’' | replace: '&lsquo;', '‘' | replace: '&ldquo;', '“' | replace: '&rdquo;', '”' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&#39;', "'" | replace: '&apos;', "'" | replace: '&amp;', '&' | strip -}}
