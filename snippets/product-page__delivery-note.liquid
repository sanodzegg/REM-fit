{%- comment -%}
  Delivery note for the product page.

  Accepts:
    block - required, the block object

  Unlike the discount and assurance blocks this is not gated on the reworked
  template — its styles have been migrated into rem-fit.css, so it renders
  everywhere.
{%- endcomment -%}

{%- assign text = block.settings.text -%}

{%- if text != blank -%}
  <div class="product__delivery-note" {{ block.shopify_attributes }}>
    {{ text }}
  </div>
{%- endif -%}
